{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmap.dev/schema/proposal/v1.json",
  "title": "Archmap Proposal",
  "description": "An external, read-only-validated mutation proposal. Authorization is evaluated separately from structural validity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_schema_version", "base_commit", "model_hash", "operations"],
  "properties": {
    "proposal_schema_version": { "type": "integer", "const": 1 },
    "base_commit": { "type": ["string", "null"] },
    "model_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target"],
      "properties": {
        "op": { "type": "string", "enum": ["add", "replace", "remove"] },
        "target": { "$ref": "#/$defs/target" },
        "value": true
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "enum": ["add", "replace"] } }, "required": ["op"] },
          "then": { "properties": { "value": true }, "required": ["value"] }
        },
        {
          "if": { "properties": { "op": { "const": "remove" } }, "required": ["op"] },
          "then": { "not": { "required": ["value"] } }
        },
        {
          "if": {
            "properties": {
              "op": { "const": "add" },
              "target": { "type": "object", "properties": { "class": { "const": "claim" } }, "required": ["class"] }
            },
            "required": ["op", "target"]
          },
          "then": { "properties": { "value": { "$ref": "#/$defs/claim" } } }
        },
        {
          "if": {
            "properties": {
              "op": { "const": "add" },
              "target": { "type": "object", "properties": { "class": { "const": "relation" } }, "required": ["class"] }
            },
            "required": ["op", "target"]
          },
          "then": { "properties": { "value": { "$ref": "#/$defs/relation" } } }
        },
        {
          "if": {
            "properties": {
              "op": { "const": "replace" },
              "target": {
                "type": "object",
                "properties": { "class": { "const": "claim" }, "field": { "const": "status" } },
                "required": ["class", "field"]
              }
            },
            "required": ["op", "target"]
          },
          "then": { "properties": { "value": { "type": "string", "enum": ["active", "stale", "rejected"] } } }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["node", "claim", "relation", "evidence", "capability", "snapshot", "project"]
        },
        "node_id": { "$ref": "#/$defs/id" },
        "id": { "$ref": "#/$defs/id" },
        "field": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "class": { "enum": ["node", "claim", "relation", "evidence"] } }, "required": ["class"] },
          "then": { "required": ["node_id"] }
        },
        {
          "if": { "type": "object", "properties": { "class": { "const": "capability" } }, "required": ["class"] },
          "then": { "required": ["id"] }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "status", "confidence", "provenance", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["fact", "inference"] },
        "text": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "stale", "rejected"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "target", "certainty", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "type": "string",
          "enum": ["calls", "reads", "writes", "imports", "publishes", "consumes", "depends-on"]
        },
        "target": { "$ref": "#/$defs/id" },
        "certainty": { "type": "string", "enum": ["known", "partial", "unknown"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "created_at"],
      "properties": {
        "actor": { "type": "string", "enum": ["analyzer", "agent", "human"] },
        "model": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path", "analyzer", "analyzer_version", "blob_hash", "extract_hash"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "analyzer": { "type": "string", "minLength": 1 },
        "analyzer_version": { "type": "string", "minLength": 1 },
        "blob_hash": { "type": "string", "minLength": 1 },
        "extract_hash": { "type": "string", "minLength": 1 }
      }
    }
  }
}
