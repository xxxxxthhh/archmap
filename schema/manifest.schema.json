{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmap.dev/schema/manifest/v1.json",
  "title": "Archmap Manifest",
  "description": "A bundle of architecture nodes. Structural contract for schema_version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities", "nodes"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["supported", "partial", "unsupported"] },
        "provides": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "kind", "title", "claims", "relations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "kind": {
          "type": "string",
          "enum": ["system", "component", "module", "external", "store"]
        },
        "title": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "status", "confidence", "provenance", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["fact", "inference"] },
        "text": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "stale", "rejected"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "created_at"],
      "properties": {
        "actor": { "type": "string", "enum": ["analyzer", "agent", "human"] },
        "model": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "target", "certainty"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "type": "string",
          "enum": ["calls", "reads", "writes", "imports", "publishes", "consumes", "depends-on"]
        },
        "target": { "$ref": "#/$defs/id" },
        "certainty": { "type": "string", "enum": ["known", "partial", "unknown"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "analyzer",
        "analyzer_version",
        "blob_hash",
        "extract_hash"
      ],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "analyzer": { "type": "string", "minLength": 1 },
        "analyzer_version": { "type": "string", "minLength": 1 },
        "blob_hash": { "type": "string", "minLength": 1 },
        "extract_hash": { "type": "string", "minLength": 1 }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
