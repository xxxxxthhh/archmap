{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmap.dev/schema/snapshot/v1.json",
  "title": "Archmap Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_commit", "dirty", "capabilities", "files", "excluded_counts"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "base_commit": { "type": ["string", "null"] },
    "dirty": { "type": "boolean" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["supported", "partial", "unsupported"] },
          "provides": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "blob_hash", "size", "category"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "blob_hash": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "category": {
            "type": "string",
            "enum": ["manifest", "doc", "config", "source", "other"]
          }
        }
      }
    },
    "excluded_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excluded-dir", "secret", "too-large", "binary", "symlink"],
      "properties": {
        "excluded-dir": { "type": "integer", "minimum": 0 },
        "secret": { "type": "integer", "minimum": 0 },
        "too-large": { "type": "integer", "minimum": 0 },
        "binary": { "type": "integer", "minimum": 0 },
        "symlink": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
