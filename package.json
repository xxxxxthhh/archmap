{
  "name": "archmap",
  "version": "0.0.0",
  "description": "Local-first, evidence-backed repository map for coding agents and humans.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archmap": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "python",
    "schema",
    "viewer"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "tsx src/cli/bin.ts validate",
    "demo": "node scripts/flagship-demo.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.0",
    "tsx": "^4.19.0",
    "vitest": "^4.0.0"
  }
}
